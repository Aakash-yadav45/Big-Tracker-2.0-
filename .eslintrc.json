{
    "extends": ["airbnb-base"],
    "env": {
      "node": true,
      "es2021": true
    },
    "rules": {
      "no-console": "warn",
      "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
      "consistent-return": "error",
      "no-underscore-dangle": "off",
      "camelcase": "error",
      "prefer-const": "error"
    }
  }
  