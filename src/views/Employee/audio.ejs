<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>🎧 Record Audio</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #e0f7fa, #f1f8e9);
            font-family: 'Segoe UI', sans-serif;
        }

        .recorder-card {
            max-width: 500px;
            margin: 5vh auto;
            padding: 2rem;
            border-radius: 1rem;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            background-color: #fff;
            text-align: center;
        }

        .recorder-title {
            font-size: 1.8rem;
            margin-bottom: 1rem;
            color: #00796b;
        }

        .btn-recorder {
            width: 180px;
            padding: 0.7rem 1rem;
            margin: 0.5rem;
            font-size: 1rem;
            transition: transform 0.2s ease;
        }

        .btn-recorder:hover {
            transform: scale(1.05);
        }

        .recording-indicator {
            display: none;
            font-size: 1rem;
            margin-top: 10px;
            color: red;
            font-weight: bold;
            animation: blink 1s infinite;
        }

        @keyframes blink {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: 0;
            }
        }

        #downloadLink {
            margin-top: 1rem;
        }

        audio {
            margin-top: 1rem;
            width: 100%;
        }

        @media (max-width: 576px) {
            .btn-recorder {
                width: 100%;
            }
        }
    </style>
</head>

<body>
    <div class="recorder-card shadow">
        <h2 class="recorder-title">🎙️ Record Your Voice</h2>

        <div class="d-flex flex-wrap justify-content-center">
            <button id="startBtn" class="btn btn-primary btn-recorder">Start Recording</button>
            <button id="pauseBtn" class="btn btn-warning btn-recorder d-none">Pause</button>
            <button id="stopBtn" class="btn btn-danger btn-recorder" disabled>Stop Recording</button>
            <button id="endDiscussionBtn" class="btn btn-dark btn-recorder d-none">Over Discussion</button>
        </div>

        <div id="recordingIndicator" class="recording-indicator">🔴 Recording... <span id="timer">0</span> sec</div>

        <audio id="audioPlayer" controls class="d-none"></audio>
        <a id="downloadLink" class="btn btn-success btn-recorder d-none" download="recording.webm">⬇️ Download</a>
    </div>

    <script>
        let mediaRecorder;
        let audioChunks = [];
        let timerInterval;
        let seconds = 0;
        let isPaused = false;

        const startBtn = document.getElementById('startBtn');
        const pauseBtn = document.getElementById('pauseBtn');
        const stopBtn = document.getElementById('stopBtn');
        const endDiscussionBtn = document.getElementById('endDiscussionBtn');
        const audioPlayer = document.getElementById('audioPlayer');
        const downloadLink = document.getElementById('downloadLink');
        const recordingIndicator = document.getElementById('recordingIndicator');
        const timer = document.getElementById('timer');

        // ✅ Load previous recording if available
        window.onload = () => {
            const savedAudio = localStorage.getItem('audioURL');
            if (savedAudio) {
                audioPlayer.src = savedAudio;
                audioPlayer.classList.remove('d-none');
                downloadLink.href = savedAudio;
                downloadLink.classList.remove('d-none');
                endDiscussionBtn.classList.remove('d-none');
            }
        };

        startBtn.onclick = async () => {
            const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
            mediaRecorder = new MediaRecorder(stream);

            audioChunks = [];
            seconds = 0;
            timer.textContent = seconds;
            isPaused = false;

            mediaRecorder.ondataavailable = event => {
                audioChunks.push(event.data);
            };

            mediaRecorder.onstop = () => {
                const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
                const audioUrl = URL.createObjectURL(audioBlob);
                audioPlayer.src = audioUrl;
                audioPlayer.classList.remove('d-none');
                downloadLink.href = audioUrl;
                downloadLink.classList.remove('d-none');
                clearInterval(timerInterval);
                recordingIndicator.style.display = 'none';
                endDiscussionBtn.classList.remove('d-none');

                // ✅ Save to localStorage
                localStorage.setItem('audioURL', audioUrl);
            };

            mediaRecorder.start();
            startBtn.disabled = true;
            stopBtn.disabled = false;
            pauseBtn.classList.remove('d-none');
            endDiscussionBtn.classList.add('d-none');
            recordingIndicator.style.display = 'block';

            timerInterval = setInterval(() => {
                if (!isPaused) {
                    seconds++;
                    timer.textContent = seconds;
                }
            }, 1000);
        };

        pauseBtn.onclick = () => {
            if (mediaRecorder.state === "recording") {
                mediaRecorder.pause();
                isPaused = true;
                pauseBtn.textContent = "Resume";
            } else if (mediaRecorder.state === "paused") {
                mediaRecorder.resume();
                isPaused = false;
                pauseBtn.textContent = "Pause";
            }
        };

        stopBtn.onclick = () => {
            if (mediaRecorder && mediaRecorder.state !== "inactive") {
                mediaRecorder.stop();
            }
            startBtn.disabled = false;
            stopBtn.disabled = true;
            pauseBtn.classList.add('d-none');
            pauseBtn.textContent = "Pause";
        };

        endDiscussionBtn.onclick = () => {
            alert("✅ Discussion ended!");

            // ✅ Optional: Clear local storage and reset UI
            localStorage.removeItem('audioURL');
            audioPlayer.src = '';
            audioPlayer.classList.add('d-none');
            downloadLink.classList.add('d-none');
            endDiscussionBtn.classList.add('d-none');
        };
    </script>

</body>

</html>