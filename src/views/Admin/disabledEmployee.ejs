<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Disabled Employees</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            padding: 20px;
        }

        h2 {
            text-align: center;
        }

        #searchEmployee {
            width: 100%;
            padding: 10px;
            margin-bottom: 20px;
            font-size: 14px;
            border-radius: 6px;
            border: 1px solid #ccc;
        }

        ul#employeeList {
            list-style-type: none;
            padding: 0;
        }

        ul#employeeList li {
            background: #fff;
            padding: 12px 16px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-radius: 8px;
            border-left: 4px solid #aaa;
            cursor: pointer;
            transition: background 0.3s;
        }

        ul#employeeList li:hover {
            background: #f0f0f0;
        }

        ul#employeeList img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
        }

        .enable-btn {
            margin-left: auto;
            padding: 6px 10px;
            font-size: 13px;
            background-color: #2ecc71;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        .enable-btn:hover {
            background-color: #27ae60;
        }
    </style>
</head>

<body>

    <h2>Disabled Employees</h2>

    <input type="text" id="searchEmployee" placeholder="Search employee..." oninput="filterEmployees()" />

    <ul id="employeeList">
        <% disabledUsers.forEach(user=> { %>
            <li onclick="selectEmployee('<%= user.username %>', '<%= user.name %>', '<%= user.mobile %>')"
                data-name="<%= user.name.toLowerCase() %>" data-username="<%= user.username.toLowerCase() %>"
                data-mobile="<%= user.mobile %>">

                <img src="/Employee.png" alt="User" />

                <span>
                    <%= user.username %>
                </span>

                <button class="enable-btn"
                    onclick="event.stopPropagation(); enableEmployee('<%= user._id %>')">Enable</button>
            </li>
            <% }) %>
    </ul>

    <script>
        function enableEmployee(id) {
            fetch(`/api/admin/enableEmployee/${id}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            }).then(res => {
                if (res.ok) {
                    alert('Employee enabled successfully');
                    location.reload();
                } else {
                    alert('Failed to enable employee');
                }
            }).catch(error => {
                console.error("Enable error:", error);
                alert("Something went wrong");
            });
        }

        function selectEmployee(username, name, mobile) {
            alert(`Selected: ${name} (${username}) - ${mobile}`);
        }

        function filterEmployees() {
            const query = document.getElementById("searchEmployee").value.toLowerCase();
            const items = document.querySelectorAll("#employeeList li");

            items.forEach(item => {
                const name = item.getAttribute("data-name");
                const username = item.getAttribute("data-username");
                const mobile = item.getAttribute("data-mobile");

                if (
                    name.includes(query) ||
                    username.includes(query) ||
                    mobile.includes(query)
                ) {
                    item.style.display = "flex";
                } else {
                    item.style.display = "none";
                }
            });
        }
    </script>

</body>

</html>