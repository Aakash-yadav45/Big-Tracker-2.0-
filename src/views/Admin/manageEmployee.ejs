<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Manage Employees</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f4f6f9;
            padding: 20px;
            margin: 0;
            overflow: auto;
        }

        h2 {
            text-align: center;
            margin-bottom: 20px;
        }

        .search-bar {
            width: 100%;
            max-width: 400px;
            margin: 0 auto 20px auto;
        }

        #searchEmployee {
            width: 100%;
            padding: 10px;
            font-size: 14px;
            border-radius: 6px;
            border: 1px solid #ccc;
        }

        .table-container {
            max-height: 80vh;
            overflow-y: auto;
            position: relative;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
            table-layout: fixed;
        }

        thead th {
            position: sticky;
            top: 0;
            background-color: #f9fafb;
            z-index: 1;
            font-weight: 600;
        }

        th,
        td {
            padding: 14px 16px;
            text-align: left;
            border-bottom: 1px solid #eee;
        }

        tr:hover {
            background-color: #f1f1f1;
        }

        .actions button {
            padding: 6px 12px;
            font-size: 13px;
            margin-right: 6px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            color: white;
        }

        .edit-btn {
            background-color: #3498db;
        }

        .edit-btn:hover {
            background-color: #2980b9;
        }

        .delete-btn {
            background-color: #e74c3c;
        }

        .delete-btn:hover {
            background-color: #c0392b;
        }

        .status-badge {
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 12px;
            color: white;
        }

        .status-enabled {
            background-color: #2ecc71;
        }

        .status-disabled {
            background-color: #e67e22;
        }

        @media (max-width: 768px) {
            table {
                font-size: 14px;
            }

            th,
            td {
                padding: 10px;
            }

            .actions button {
                margin-bottom: 4px;
            }
        }

        th:first-child,
        td:first-child {
            width: 50px;
            text-align: center;
        }
    </style>
</head>

<body>

    <h2>Manage Employees</h2>

    <div style="text-align: center; margin-bottom: 20px;">
        <button onclick="addEmployee()"
            style="background-color: #2ecc71; color: white; padding: 10px 16px; border: none; border-radius: 6px; font-size: 14px; cursor: pointer;">
            Add Employee
        </button>
    </div>

    <div class="search-bar">
        <input type="text" id="searchEmployee" placeholder="Search by name, username, or mobile..."
            oninput="filterEmployees()" />
    </div>

    <div class="table-container">
        <table id="employeeTable">
            <thead>
                <tr>
                    <th>S. No.</th>
                    <th>Username</th>
                    <th>Name</th>
                    <th>Mobile</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% employees.forEach((employee, index)=> { %>
                    <tr data-name="<%= employee.name.toLowerCase() %>"
                        data-username="<%= employee.username.toLowerCase() %>" data-mobile="<%= employee.mobile %>">
                        <td>
                            <%= index + 1 %>
                        </td>
                        <td>
                            <%= employee.username %>
                        </td>
                        <td>
                            <%= employee.name %>
                        </td>
                        <td>
                            <%= employee.mobile %>
                        </td>
                        <td>
                            <span class="status-badge <%= employee.isDisable ? 'status-disabled' : 'status-enabled' %>">
                                <%= employee.isDisable ? 'Disabled' : 'Enabled' %>
                            </span>
                        </td>
                        <td class="actions">
                            <button class="edit-btn" onclick="enableEmployee('<%= employee._id %>')">Enable</button>
                            <button class="delete-btn" onclick="deleteEmployee('<%= employee._id %>')">Disable</button>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
    </div>

    <div id="responseContainer" style="display: none;"></div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        function filterEmployees() {
            const query = document.getElementById("searchEmployee").value.toLowerCase();
            const rows = document.querySelectorAll("#employeeTable tbody tr");

            rows.forEach(row => {
                const name = row.getAttribute("data-name");
                const username = row.getAttribute("data-username");
                const mobile = row.getAttribute("data-mobile");

                if (
                    name.includes(query) ||
                    username.includes(query) ||
                    mobile.includes(query)
                ) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        }

        function enableEmployee(id) {
            $.ajax({
                url: `/api/admin/enableEmployee/${id}`,
                method: 'POST',
                contentType: 'application/json',
                success: function (response) {
                    console.log(response);
                    alert('Employee enabled successfully');
                    location.reload();
                },
                error: function (xhr, status, error) {
                    console.error("Enable error:", error);
                    const message = xhr.responseJSON.data || xhr.responseJSON.message
                    // Check for specific status codes
                    if (xhr.status === 400) {
                        alert(message||'Invalid employee ID or bad request.');
                    } else if (xhr.status === 401) {
                        alert('Unauthorized: Please login first.');
                    } else if (xhr.status === 403) {
                        alert('Forbidden: You don’t have permission to perform this action.');
                    } else if (xhr.status === 404) {
                        alert('Employee not found.');
                    } else if (xhr.status === 500) {
                        alert('Server error: Please try again later.');
                    } else {
                        alert(`Unexpected error: ${xhr.status} - ${xhr.statusText}`);
                    }
                }
            });
        }


        function deleteEmployee(id) {
            if (confirm("Are you sure you want to delete this employee?")) {
                $.ajax({
                    url: `/api/admin/deleteEmployee/${id}`,
                    method: 'DELETE',
                    success: function () {
                        alert('Employee deleted successfully');
                        location.reload();
                    },
                    error: function () {
                        alert('Failed to delete employee');
                    }
                });
            }
        }

        function addEmployee() {
            $.ajax({
                url: '/api/admin/addEmployee',
                method: 'GET',
                success: function (response) {
                    $('body').children().not('#responseContainer').hide();
                    $('#responseContainer').html(response).css({
                        position: 'fixed',
                        top: 0,
                        left: 0,
                        width: '100vw',
                        height: '100vh',
                        background: '#fff',
                        overflowY: 'auto',
                        zIndex: 9999,
                        padding: '20px',
                        display: 'block'
                    });
                },
                error: function () {
                    alert('Failed to load Add Employee page');
                }
            });
        }
    </script>

</body>

</html>